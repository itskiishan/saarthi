# SaarThi Backend Environment Configuration

# Server Port (default: 3000)
PORT=3000

# Enable/Disable LLM integration (true/false)
USE_LLM=true

# Groq LLM Configuration (Primary LLM)
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=llama-3.1-8b-instant

# Hugging Face LLM Configuration (Optional Fallback)
HUGGINGFACE_API_KEY=your_huggingface_api_key_here
HUGGINGFACE_MODEL=your_huggingface_model_id_here

# Translation API Configurations (Optional)
GOOGLE_TRANSLATE_API_KEY=your_google_translate_api_key_here
LIBRETRANSLATE_URL=https://libretranslate.com
LIBRETRANSLATE_API_KEY=your_libretranslate_api_key_here
